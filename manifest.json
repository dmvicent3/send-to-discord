{
  "manifest_version": 3,
  "name": "X to Discord",
  "version": "0.1.0",
  "description": "Adds a button to X posts that sends the fxtwitter link to a Discord webhook.",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-to-discord@dmvicent3",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["browsingActivity"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*",
    "https://ptb.discord.com/api/webhooks/*",
    "https://canary.discord.com/api/webhooks/*"
  ],
  "background": { "scripts": ["src/webhook.js", "src/background.js"] },
  "options_ui": { "page": "src/options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*", "*://mobile.twitter.com/*"],
      "js": ["src/fxurl.js", "src/button-state.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
