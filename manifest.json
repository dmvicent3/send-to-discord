{
  "manifest_version": 3,
  "name": "Send to Discord",
  "version": "0.2.0",
  "description": "Adds a button to X, Reddit and YouTube posts that sends them to a Discord webhook.",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-to-discord@dmvicent3",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["browsingActivity", "websiteContent"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*",
    "https://ptb.discord.com/api/webhooks/*",
    "https://canary.discord.com/api/webhooks/*",
    "https://i.redd.it/*",
    "https://preview.redd.it/*",
    "https://vxreddit.com/*",
    "https://renders.vxreddit.com/*",
    "https://*.lambda-url.us-east-1.on.aws/*"
  ],
  "background": { "scripts": ["src/core/webhook.js", "src/background.js"] },
  "options_ui": { "page": "src/options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*", "*://mobile.twitter.com/*"],
      "js": ["src/core/button-state.js", "src/core/arm.js", "src/sites/fxurl.js", "src/sites/x-dom.js", "src/sites/x.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.reddit.com/*", "*://old.reddit.com/*"],
      "js": ["src/core/button-state.js", "src/core/arm.js", "src/sites/reddit-share.js", "src/sites/reddit-dom.js", "src/sites/reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/core/button-state.js", "src/core/arm.js", "src/sites/youtube-url.js", "src/sites/youtube.js"],
      "run_at": "document_idle"
    }
  ]
}
